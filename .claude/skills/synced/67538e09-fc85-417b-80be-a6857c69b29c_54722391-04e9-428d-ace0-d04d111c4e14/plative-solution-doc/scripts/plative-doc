#!/usr/bin/env python3
"""
plative-doc — HTML-first Plative-branded document generator.

Generates a fully-branded HTML document, then converts to the requested format.

Usage:
  plative-doc --client "REBNY" --project "Order Management" --output doc.docx --input content.md
  plative-doc --client "REBNY" --project "Order Management" --format pdf  --output doc.pdf  --input content.md
  plative-doc --client "REBNY" --project "Order Management" --format html --output doc.html --input content.md
  plative-doc --client "REBNY" --project "Order Management" --format pptx --output doc.pptx --input content.md

Supported formats: html, docx, pdf, pptx (inferred from --output extension if --format omitted)
"""

import argparse
import os
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

try:
    import markdown as md_lib
except ImportError:
    print("Error: pip install markdown", file=sys.stderr)
    sys.exit(1)

# ── Asset paths ───────────────────────────────────────────────────────────────
SKILL_DIR  = Path(__file__).resolve().parent.parent
FONT_DIR   = SKILL_DIR / "assets" / "design-system" / "fonts"
LOGO_WHITE = SKILL_DIR / "assets" / "design-system" / "assets" / "logos" / "plative-logo-white.png"
LOGO_BLACK = SKILL_DIR / "assets" / "design-system" / "assets" / "logos" / "plative-logo-black.png"
COVER_BG   = SKILL_DIR / "assets" / "design-system" / "assets" / "graphics" / "gradient-4-navy.jpg"

# ── Brand tokens ──────────────────────────────────────────────────────────────
CRIMSON   = "#E14136"
NAVY      = "#262A42"
SOFT_NAVY = "#425582"
TEAL      = "#0D9DA4"
GRAPHITE  = "#4A4F66"
SLATE     = "#7C8299"
FOG       = "#E6E8EE"
PAPER     = "#F5F6F8"
WHITE     = "#FFFFFF"


def font_face_css() -> str:
    if not FONT_DIR.exists():
        return ""
    weights = [
        ("OpenSans-Light.ttf",          300, "normal"),
        ("OpenSans-Regular.ttf",        400, "normal"),
        ("OpenSans-Medium.ttf",         500, "normal"),
        ("OpenSans-SemiBold.ttf",       600, "normal"),
        ("OpenSans-Bold.ttf",           700, "normal"),
        ("OpenSans-ExtraBold.ttf",      800, "normal"),
        ("OpenSans-LightItalic.ttf",    300, "italic"),
        ("OpenSans-Italic.ttf",         400, "italic"),
        ("OpenSans-SemiBoldItalic.ttf", 600, "italic"),
        ("OpenSans-BoldItalic.ttf",     700, "italic"),
    ]
    lines = []
    for filename, weight, style in weights:
        path = FONT_DIR / filename
        if path.exists():
            lines.append(
                f"@font-face {{\n"
                f"  font-family: 'Open Sans';\n"
                f"  src: url('file://{path}') format('truetype');\n"
                f"  font-weight: {weight};\n"
                f"  font-style: {style};\n"
                f"}}"
            )
    return "\n".join(lines)


def logo_tag(path: Path, height="26px", style="") -> str:
    if path.exists():
        return f'<img src="file://{path}" alt="Plative" style="height:{height};display:block;{style}">'
    return f'<span style="font-weight:700;letter-spacing:0.12em;font-size:14px;">PLATIVE</span>'


def build_html(client: str, project: str, date_str: str, body_html: str) -> str:
    fonts_css = font_face_css()
    logo_white_tag = logo_tag(LOGO_WHITE, height="26px")
    logo_black_tag = logo_tag(LOGO_BLACK, height="20px")
    cover_bg = (
        f"background-image:url('file://{COVER_BG}');background-size:cover;background-position:center;"
        if COVER_BG.exists() else f"background:{NAVY};"
    )

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{client} · {project}</title>
<style>
{fonts_css}

*,*::before,*::after{{box-sizing:border-box;margin:0;padding:0;}}
html{{font-size:16px;}}
body{{
  font-family:'Open Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
  color:{GRAPHITE};
  background:{WHITE};
  line-height:1.6;
}}

/* ── Cover ── */
.cover{{
  {cover_bg}
  min-height:100vh;
  padding:48px 72px 72px;
  display:flex;
  flex-direction:column;
  position:relative;
  page-break-after:always;
}}
.cover::after{{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(160deg,rgba(38,42,66,.72) 0%,rgba(38,42,66,.9) 100%);
  z-index:0;
}}
.cover>*{{position:relative;z-index:1;}}
.cover-nav{{
  display:flex;
  align-items:center;
  justify-content:space-between;
}}
.cover-meta{{
  font-size:11px;font-weight:600;letter-spacing:.18em;
  text-transform:uppercase;color:rgba(255,255,255,.65);
}}
.cover-body{{margin-top:auto;padding-top:100px;}}
.cover-eyebrow{{
  font-size:11px;font-weight:600;letter-spacing:.22em;
  text-transform:uppercase;color:rgba(255,255,255,.7);margin-bottom:16px;
}}
.cover-rule{{
  width:56px;height:4px;background:{CRIMSON};
  margin-bottom:22px;border:none;
}}
.cover-client{{
  font-size:13px;font-weight:700;letter-spacing:.2em;
  text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:10px;
}}
.cover-title{{
  font-size:50px;font-weight:600;line-height:1.06;
  letter-spacing:-.02em;color:{WHITE};
  margin-bottom:28px;max-width:720px;
}}
.cover-date{{font-size:12px;color:rgba(255,255,255,.55);}}

/* ── Doc header ── */
.doc-header{{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 72px 14px;border-bottom:1px solid {FOG};
}}
.doc-header-right{{
  font-size:11px;font-weight:600;letter-spacing:.1em;
  text-transform:uppercase;color:{SLATE};
}}

/* ── Content ── */
.content{{max-width:860px;margin:0 auto;padding:52px 72px 80px;}}

.content h1{{
  font-size:22px;font-weight:600;color:{NAVY};
  margin:52px 0 14px;padding-top:18px;
  border-top:3px solid {CRIMSON};
  letter-spacing:-.01em;
}}
.content h1:first-child{{margin-top:0;}}
.content h1::before{{
  content:"Section";
  display:block;font-size:9px;font-weight:700;
  letter-spacing:.2em;text-transform:uppercase;
  color:{CRIMSON};margin-bottom:8px;
}}
.content h2{{
  font-size:16px;font-weight:600;color:{NAVY};
  margin:28px 0 8px;
}}
.content h3{{
  font-size:13px;font-weight:600;color:{SOFT_NAVY};
  margin:20px 0 6px;
}}
.content p{{
  font-size:11pt;color:{GRAPHITE};
  line-height:1.65;margin-bottom:12px;
}}
.content ul,.content ol{{margin:8px 0 14px 24px;}}
.content li{{
  font-size:11pt;color:{GRAPHITE};
  line-height:1.6;margin-bottom:4px;
}}
.content code{{
  font-family:'Courier New',monospace;font-size:10pt;
  background:{PAPER};color:{TEAL};
  padding:1px 5px;border-radius:3px;
  border:1px solid {FOG};
}}
.content pre{{
  background:{NAVY};color:rgba(255,255,255,.88);
  padding:18px 22px;border-radius:6px;
  overflow-x:auto;margin:14px 0 18px;
  font-size:10pt;line-height:1.5;
}}
.content pre code{{background:none;border:none;color:inherit;padding:0;}}
.content table{{
  width:100%;border-collapse:collapse;
  margin:14px 0 20px;font-size:10.5pt;
}}
.content th{{
  background:{NAVY};color:{WHITE};
  font-weight:600;text-align:left;
  padding:10px 14px;font-size:10pt;letter-spacing:.04em;
}}
.content td{{
  padding:9px 14px;border-bottom:1px solid {FOG};
  color:{GRAPHITE};vertical-align:top;
}}
.content tr:nth-child(even) td{{background:{PAPER};}}
.content blockquote{{
  border-left:3px solid {CRIMSON};
  padding:10px 18px;margin:14px 0;
  background:{PAPER};border-radius:0 4px 4px 0;
}}
.content blockquote p{{color:{NAVY};font-style:italic;margin:0;}}
.content hr{{border:none;border-top:1px solid {FOG};margin:28px 0;}}
.content strong{{color:{NAVY};font-weight:600;}}

/* ── Footer ── */
.doc-footer{{
  border-top:1px solid {FOG};padding:14px 72px;
  display:flex;justify-content:space-between;align-items:center;
  font-size:10px;color:{SLATE};font-weight:500;
  letter-spacing:.06em;text-transform:uppercase;
}}

/* ── Print ── */
@media print{{
  .cover{{min-height:100vh;page-break-after:always;}}
  .content h1{{page-break-before:auto;}}
  pre,blockquote,table{{page-break-inside:avoid;}}
  @page{{margin:0;size:Letter;}}
}}
</style>
</head>
<body>

<div class="cover">
  <div class="cover-nav">
    {logo_white_tag}
    <span class="cover-meta">Technical Solution Document · {date_str}</span>
  </div>
  <div class="cover-body">
    <div class="cover-eyebrow">Plative · Technical Delivery</div>
    <hr class="cover-rule">
    <div class="cover-client">{client}</div>
    <h1 class="cover-title">{project}</h1>
    <div class="cover-date">Prepared by Plative Inc. · {date_str} · Confidential</div>
  </div>
</div>

<div class="doc-header">
  {logo_black_tag}
  <span class="doc-header-right">{client} · {project}</span>
</div>

<div class="content">
{body_html}
</div>

<div class="doc-footer">
  <span>Confidential · Plative Inc.</span>
  <span>{client} · {project} · {date_str}</span>
</div>

</body>
</html>"""


# ── Converters ────────────────────────────────────────────────────────────────

def to_docx(html: Path, out: Path) -> bool:
    r = subprocess.run(
        ["pandoc", str(html), "-o", str(out), "--from=html", "--to=docx"],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        print(f"pandoc: {r.stderr}", file=sys.stderr)
    return r.returncode == 0


def to_pdf(html: Path, out: Path) -> bool:
    for chrome in [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "/usr/bin/google-chrome",
        "/usr/bin/chromium-browser",
    ]:
        if Path(chrome).exists():
            subprocess.run(
                [chrome, "--headless=new", "--disable-gpu", "--no-sandbox",
                 "--run-all-compositor-stages-before-draw",
                 f"--print-to-pdf={out}", f"file://{html}"],
                capture_output=True
            )
            return out.exists()
    print("Chrome not found for PDF export", file=sys.stderr)
    return False


def to_pptx(html: Path, out: Path, project: str, date_str: str) -> bool:
    r = subprocess.run(
        ["pandoc", str(html), "-o", str(out), "--from=html", "--to=pptx",
         f"--metadata=title:{project}",
         "--metadata=author:Plative Inc.",
         f"--metadata=date:{date_str}"],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        print(f"pandoc: {r.stderr}", file=sys.stderr)
    return r.returncode == 0


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--client",  required=True)
    parser.add_argument("--project", required=True)
    parser.add_argument("--output",  required=True)
    parser.add_argument("--input",   default=None)
    parser.add_argument("--format",  default=None, help="html|docx|pdf|pptx")
    parser.add_argument("--date",    default=None)
    args = parser.parse_args()

    date_str = args.date or datetime.now().strftime("%B %Y")
    out = Path(args.output).expanduser().resolve()
    out.parent.mkdir(parents=True, exist_ok=True)

    # Infer format
    fmt = (args.format or out.suffix.lstrip(".")).lower()
    if fmt not in ("html", "docx", "pdf", "pptx"):
        fmt = "html"

    # Read content
    if args.input:
        content = Path(args.input).expanduser().read_text()
    elif not sys.stdin.isatty():
        content = sys.stdin.read()
    else:
        print("Error: provide --input or pipe via stdin", file=sys.stderr)
        sys.exit(1)

    # Build HTML
    body_html = md_lib.markdown(
        content,
        extensions=["tables", "fenced_code", "sane_lists", "nl2br", "md_in_html"],
        extension_configs={"extra": {"enable_attributes": True}}
    )
    full_html = build_html(args.client, args.project, date_str, body_html)

    # Output
    if fmt == "html":
        out.write_text(full_html, encoding="utf-8")
        print(f"✓ {out}")
        return

    with tempfile.NamedTemporaryFile(suffix=".html", delete=False, mode="w", encoding="utf-8") as f:
        f.write(full_html)
        tmp_html = Path(f.name)

    try:
        ok = False
        if fmt == "docx":
            ok = to_docx(tmp_html, out)
        elif fmt == "pdf":
            ok = to_pdf(tmp_html, out)
        elif fmt == "pptx":
            ok = to_pptx(tmp_html, out, args.project, date_str)

        if ok:
            print(f"✓ {out}")
        else:
            print(f"✗ {fmt} conversion failed", file=sys.stderr)
            sys.exit(1)
    finally:
        tmp_html.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
