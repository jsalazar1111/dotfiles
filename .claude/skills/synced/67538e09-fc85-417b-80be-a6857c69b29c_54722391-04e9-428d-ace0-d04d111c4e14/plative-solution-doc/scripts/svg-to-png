#!/usr/bin/env python3
"""
svg-to-png — extract <svg> blocks from an HTML file and rasterize each to PNG.

Usage:
  svg-to-png <html_file> <output_dir>

Writes: <output_dir>/diagram-0.png, diagram-1.png, ...
Prints the list of output paths to stdout (one per line).
"""
import re
import subprocess
import sys
import tempfile
from pathlib import Path

CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Matches the outer <div> wrapper we write around SVGs, or a bare <svg>
SVG_BLOCK = re.compile(
    r'(<div[^>]*>\s*<svg[\s\S]*?</svg>\s*</div>|<svg[\s\S]*?</svg>)',
    re.IGNORECASE
)

WRAPPER = """<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
*{{box-sizing:border-box;margin:0;padding:0;}}
body{{background:#ffffff;display:flex;align-items:flex-start;justify-content:flex-start;padding:0;}}
svg{{display:block;max-width:100%;height:auto;}}
div{{display:block;}}
</style>
</head><body>{svg}</body></html>"""


def extract_svgs(html: str) -> list[str]:
    return [m.group(0) for m in SVG_BLOCK.finditer(html)]


def rasterize(svg_html: str, out_path: Path, width: int = 1400) -> bool:
    with tempfile.NamedTemporaryFile(suffix=".html", delete=False, mode="w", encoding="utf-8") as f:
        f.write(WRAPPER.format(svg=svg_html))
        tmp = Path(f.name)
    try:
        r = subprocess.run(
            [CHROME,
             "--headless=new", "--disable-gpu", "--no-sandbox",
             "--hide-scrollbars",
             f"--window-size={width},800",
             "--default-background-color=ffffffff",
             f"--screenshot={out_path}",
             f"file://{tmp}"],
            capture_output=True, timeout=20
        )
        # Chrome crops to content via --screenshot; verify output exists
        return out_path.exists() and out_path.stat().st_size > 0
    finally:
        tmp.unlink(missing_ok=True)


def main():
    if len(sys.argv) < 3:
        print(f"Usage: {sys.argv[0]} <html_file> <output_dir>", file=sys.stderr)
        sys.exit(1)

    html_file = Path(sys.argv[1])
    out_dir = Path(sys.argv[2])
    out_dir.mkdir(parents=True, exist_ok=True)

    html = html_file.read_text(encoding="utf-8")
    svgs = extract_svgs(html)

    if not svgs:
        sys.exit(0)

    for i, svg in enumerate(svgs):
        out_path = out_dir / f"diagram-{i}.png"
        ok = rasterize(svg, out_path)
        if ok:
            print(str(out_path))
        else:
            print(f"FAILED: diagram-{i}", file=sys.stderr)


if __name__ == "__main__":
    main()
